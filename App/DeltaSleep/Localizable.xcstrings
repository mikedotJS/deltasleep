  "strings": {
    "%lld nuits sur %lld": {
      "comment": "Best-effort key for Text(\"\\(measured) nuits sur \\(required)\") — an Int interpolation extracts as %lld; unverified against real Xcode extraction (no local toolchain), so this may need reconciling once someone opens the project in Xcode (P9 status note).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nights out of %lld"
          }
        }
      }
    },
